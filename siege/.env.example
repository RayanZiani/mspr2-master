# Base MySQL centralisée (Aiven) — mêmes données que les scripts d'import
MYSQL_URL=mysql://user:password@host:20300/defaultdb?ssl-mode=REQUIRED
MYSQL_SSL_CA=/app/database/ca.pem

REDIS_URL=redis://redis-siege:6379
REDIS_CACHE_TTL=60
MESURES_DAYS=30
MESURES_LIMIT=5000

# URLs internes Docker des APIs pays (agrégateur siège)
API_BRESIL_URL=http://api-bresil:8000
API_EQUATEUR_URL=http://api-equateur:8000
API_COLOMBIE_URL=http://api-colombie:8000

# Auth (API siège)
# Génère un hash PBKDF2 (recommandé ici car ne dépend pas de bcrypt):
#   python -c "from passlib.hash import pbkdf2_sha256; print(pbkdf2_sha256.hash('change_me'))"
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD_HASH=$pbkdf2-sha256$29000$REPLACE_ME_HASH
AUTH_JWT_SECRET=change_me_secret
AUTH_ACCESS_TTL_MINUTES=480

# Webhook Discord (alertes temperature / humidite hors seuils)
DISCORD_WEBHOOK_URL=
